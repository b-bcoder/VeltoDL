{
  "name": "VeltoDL",
  "version": "1.0.1",
  "private": true,
  "description": "A desktop video downloader built with Electron and yt-dlp",
  "author": "B&B Coder",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "youtube-dl-exec": "3.1.19"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "ffmpeg-static": "5.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.veltodl.desktop",
    "productName": "VeltoDL",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/youtube-dl-exec/bin/**"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg/ffmpeg.exe.LICENSE"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg/ffmpeg.exe.README"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "youtube-dl-exec@3.1.19": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
